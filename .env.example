# Required in production
ADMIN_PASSWORD=change-me
ORIGIN=https://checkin.example.com

# Shown to attendees in the consent line
ORG_NAME=SRKK
# PRIVACY_URL=https://example.com/privacy

# Local phone formats (0812…) are read as this country. ID = Indonesia, MY = Malaysia
DEFAULT_PHONE_COUNTRY=ID
DEFAULT_TIMEZONE=Asia/Jakarta

# SQLite file; mount a persistent volume here in production
DB_PATH=data/attendance.db

# Behind a reverse proxy (Coolify/Traefik): real client IPs for rate limiting
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Optional overrides
# PUBLIC_BASE_URL=https://checkin.example.com
# SESSION_SECRET=
